      <site name="imu"/>
    <!-- Correctly allocated motor locations -->
    <site name="motor1" pos="0.03252 -0.03252 0" size="0.005"/>
    <site name="motor2" pos="-0.03252  -0.03252 0" size="0.005"/>
    <site name="motor3" pos=" -0.03252  0.03252 0" size="0.005"/>
    <site name="motor4" pos=" 0.03252 0.03252 0" size="0.005"/>
    </body>
  </worldbody>

  <actuator>
    <motor class="cf2" ctrllimited="true" ctrlrange="0 0.14" gear="0 0 1 0 0 -0.006" site="motor1" name="f1"/>
    <motor class="cf2" ctrllimited="true" ctrlrange="0 0.14" gear="0 0 1 0 0 0.006" site="motor2" name="f2"/>
    <motor class="cf2" ctrllimited="true" ctrlrange="0 0.14" gear="0 0 1 0 0 -0.006" site="motor3" name="f3"/>
    <motor class="cf2" ctrllimited="true" ctrlrange="0 0.14" gear="0 0 1 0 0 0.006" site="motor4" name="f4"/>
  </actuator>



  <sensor>
    <gyro name="body_gyro" site="imu"/>
    <accelerometer name="body_linacc" site="imu"/>
    <framequat name="body_quat" objtype="site" objname="imu"/>
  </sensor>

</mujoco>
